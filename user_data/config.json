{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "market-opportunity-scanner",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 10,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "gate",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      ".*/USDT:USDT"
    ],
    "pair_blacklist": [
      ".*(UP|DOWN|BULL|BEAR)/.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    },
    {
      "method": "PairInformationFilter",
      "selection_mode": "blacklist",
      "info_key": "info.contract_type",
      "info_compare_value": "stocks"
    },
    {
      "method": "PairInformationFilter",
      "selection_mode": "blacklist",
      "info_key": "info.contract_type",
      "info_compare_value": "indices"
    },
    {
      "method": "PairInformationFilter",
      "selection_mode": "blacklist",
      "info_key": "info.contract_type",
      "info_compare_value": "commodities"
    },
    {
      "method": "PairInformationFilter",
      "selection_mode": "blacklist",
      "info_key": "info.contract_type",
      "info_compare_value": "forex"
    },
    {
      "method": "PairInformationFilter",
      "selection_mode": "blacklist",
      "info_key": "info.contract_type",
      "info_compare_value": "metals"
    },
    {
      "method": "VolumePairList",
      "number_assets": 150,
      "sort_key": "quoteVolume",
      "refresh_period": 1800
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 14
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.003
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "allow_custom_messages": true
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
